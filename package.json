{
  "name": "agentic-realtime",
  "version": "0.4.1",
  "description": "Live edits for people and agents on one document, with offline support.",
  "keywords": [
    "yjs",
    "crdt",
    "realtime",
    "collaboration",
    "presence",
    "offline",
    "agents",
    "durable-objects",
    "cloudflare",
    "mcp"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-sync.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md",
    "SKILL.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-realtime",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./firestore": {
      "types": "./dist/firestore/index.d.ts",
      "import": "./dist/firestore/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "example": "WRANGLER_SEND_METRICS=false wrangler dev --config examples/host/wrangler.jsonc",
    "deploy:demo": "npm run build && WRANGLER_SEND_METRICS=false wrangler deploy --config examples/host/wrangler.demo.jsonc",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.14",
    "lib0": "^0.2.119",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.6",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "bin": {
    "agentic-realtime": "./dist/cli.js",
    "agentic-realtime-mcp": "./dist/mcp-bin.js"
  }
}
