{
  // Sample config. A host copies this next to its own worker, which calls
  // createSyncWorker with an authorize hook and re-exports SyncRoom.
  "name": "agentic-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
  "vars": { "SYNC_JURISDICTION": "eu" }
}
